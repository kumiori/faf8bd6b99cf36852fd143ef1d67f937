  "exercise.reconstruct.graph" -> "exercise.reconstruct.network" [id="exercise.reconstruct.sort.exercise.reconstruct.graph.cancelled.exercise.reconstruct.network", label="Sort participants / cancelled", color="#2e7d32", style=solid];
  "exercise.reconstruct.graph" -> "exercise.reconstruct.graph" [id="exercise.reconstruct.sort.exercise.reconstruct.graph.cancelled.exercise.reconstruct.graph", label="Sort participants / cancelled", color="#2e7d32", style=solid];
  "exercise.reconstruct.graph" -> "exercise.reconstruct.directory" [id="exercise.reconstruct.sort.exercise.reconstruct.graph.error.exercise.reconstruct.directory", label="Sort participants / error", color="#607d8b", style=solid];
  "exercise.reconstruct.graph" -> "exercise.reconstruct.profile" [id="exercise.reconstruct.sort.exercise.reconstruct.graph.error.exercise.reconstruct.profile", label="Sort participants / error", color="#607d8b", style=solid];
  "exercise.reconstruct.graph" -> "exercise.reconstruct.network" [id="exercise.reconstruct.sort.exercise.reconstruct.graph.error.exercise.reconstruct.network", label="Sort participants / error", color="#607d8b", style=solid];
  "exercise.reconstruct.graph" -> "exercise.reconstruct.graph" [id="exercise.reconstruct.sort.exercise.reconstruct.graph.error.exercise.reconstruct.graph", label="Sort participants / error", color="#607d8b", style=solid];
  "exercise.reconstruct.graph" -> "exercise.reconstruct.quit" [id="exercise.reconstruct.sort.exercise.reconstruct.graph.aborted.exercise.reconstruct.quit", label="Sort participants / aborted", color="#607d8b", style=solid];
  subgraph cluster_legend {
    label="Legend (presentation only)";
    legend [shape=note, label="Grey: navigation / disabled\nPurple: state change\nAmber: conditional / extraction uncertainty\nRed: confirmed graph defect\nGreen: recovery"];
  }
}
